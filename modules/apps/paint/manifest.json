{
  "app": "paint",
  "version": "1.0",
  "capabilities": [
    {
      "action": "new_canvas",
      "description": "Crée une nouvelle toile vide",
      "params": {
        "width": "int",
        "height": "int"
      },
      "trigger": {
        "type": "api_call",
        "method": "canvas.new"
      }
    },
    {
      "action": "set_color",
      "description": "Change la couleur active du pinceau",
      "params": {
        "color": "hex"
      },
      "trigger": {
        "type": "api_call",
        "method": "canvas.setColor"
      }
    },
    {
      "action": "draw_line",
      "description": "Dessine une ligne droite sur la toile",
      "params": {
        "x1": "int",
        "y1": "int",
        "x2": "int",
        "y2": "int",
        "color": "hex",
        "width": "int"
      },
      "trigger": {
        "type": "api_call",
        "method": "canvas.drawLine"
      }
    }
  ]
}
